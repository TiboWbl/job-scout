# Copy to .env.local and fill in. Never commit .env.local, never paste keys in a chat.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local only, used by `npm run db:migrate` (Connect > Session pooler URI, with your password)
SUPABASE_DB_URL=

# Admin access (collection button, source health). Your Google account email.
ADMIN_EMAIL=
# Invite-only access: comma-separated Google emails, on top of those invited from the admin page
INVITED_EMAILS=

# LLM: "mistral" or "mock" (mock works without any key, heuristic scoring)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
LLM_MODEL_FAST=ministral-14b-2512
LLM_MODEL_STRONG=ministral-14b-2512

# logo.dev publishable token (pk_...), safe to expose in image URLs
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Optional extra sources
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

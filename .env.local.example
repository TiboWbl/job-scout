# Copy to .env.local and fill in. Never commit .env.local, never paste keys in a chat.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local only, used by `npm run db:migrate` (Connect > Session pooler URI, with your password)
SUPABASE_DB_URL=

# Admin access (collection button, source health). Your Google account email.
ADMIN_EMAIL=
# Invite-only access: comma-separated Google emails, on top of those invited from the admin page
INVITED_EMAILS=

# LLM: required. Without a reachable model the app says so and retries; it never guesses.
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
LLM_MODEL_FAST=ministral-14b-2512
LLM_MODEL_STRONG=ministral-14b-2512

# logo.dev publishable token (pk_...), safe to expose in image URLs
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Optional extra sources
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble job search API key (free, requested on jooble.org/api/about)
JOOBLE_API_KEY=

# Optional: contact shown on the public privacy page
CONTACT_EMAIL=

# Optional: starts a full collection on GitHub Actions when someone changes their search.
# Fine-grained token, this repository only, permission "Actions: Read and write". Vercel only.
GITHUB_DISPATCH_TOKEN=

# Optional: lets Vercel Cron start the morning and evening collections (any long random string). Vercel only.
CRON_SECRET=
